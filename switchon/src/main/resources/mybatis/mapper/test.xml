<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "//mybatis.org/DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.switchon.diet.test.dao.ITestDAO">

	<insert id="testMember" parameterType="com.switchon.diet.test.vo.TestVO">
		
		INSERT INTO test_member(testNm)
		VALUES (#{testNm})
		
	</insert>
	
	<select id="loginTest" parameterType="com.switchon.diet.test.vo.TestVO" resultType="com.switchon.diet.test.vo.TestVO">
		
		SELECT testNm
		FROM test_member
		WHERE testNm = #{testNm}
	
	</select>
	
	
	
	
	
</mapper>